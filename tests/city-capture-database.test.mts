import {PGlite} from '@electric-sql/pglite';
import assert from 'node:assert/strict';
import {readFile} from 'node:fs/promises';

for(const rate of [1,10,100]){
 const db=new PGlite();
 const ids=['11111111-1111-4111-8111-111111111111','22222222-2222-4222-8222-222222222222'];
 const rows=async(sql:string,args:any[]=[]) => (await db.query<any>(sql,args)).rows;
 const scalar=async(sql:string,args:any[]=[]) => Object.values((await rows(sql,args))[0])[0] as any;
 try{
  await db.exec(`create schema auth;create table auth.users(id uuid primary key);create role anon;create role authenticated;create role service_role;create function auth.uid()returns uuid language sql as $$select nullif(current_setting('request.jwt.claim.sub',true),'')::uuid$$;grant usage on schema public,auth to authenticated,anon;grant execute on function auth.uid()to authenticated,anon;create publication supabase_realtime`);
  let fresh=(await readFile('supabase/FRESH_INSTALL_V19.sql','utf8')).replaceAll('\r\n','\n');
  if(rate===10)for(const module of ['conquest-schema.sql','conquest.sql'])fresh=fresh.replace((await readFile('supabase/modules/city/'+module,'utf8')).replaceAll('\r\n','\n'),'');
  await db.exec(fresh);
  await db.exec(`select public.peris_configure_test_clock(${rate});update public.peris_world_clock set game_anchor='2030-01-01',real_anchor=now();insert into auth.users values('${ids[0]}'),('${ids[1]}')`);
  for(const i of [1,0])await db.exec(`select set_config('request.jwt.claim.sub','${ids[i]}',false);select public.create_player('Capture ${rate} ${i}')`);
  if(rate===10){assert.equal((await scalar(`select public.peris_snapshot()`)).conquest_version,undefined);await db.exec(await readFile('supabase/UPGRADE_CITY_CAPTURE.sql','utf8'));}
  const city=await scalar(`select id from public.settlements where owner_id='${ids[1]}'`),home=await scalar(`select id from public.settlements where owner_id='${ids[0]}'`),army=await scalar(`select id from public.armies where owner_id='${ids[0]}'`),defender=await scalar(`select id from public.armies where owner_id='${ids[1]}'`);
  assert.equal(await scalar(`select public.peris_roster('{"diplomat":7}')->>'diplomat'`),'7');
  assert.equal(await scalar(`select count(*)::int from public.peris_unit_balance where unit='diplomat'`),2);
  assert.equal(Number(await scalar(`select public.peris_troop_upkeep('{"diplomat":60}')`)),1);
  await db.exec(`select set_config('request.jwt.claim.sub','${ids[0]}',false)`);
  assert.equal((await scalar(`select public.peris_snapshot()`)).conquest_version,1);
  assert.ok(!(JSON.stringify(await scalar(`select public.peris_map_snapshot(-100,-100,99,99)`))).includes('loyalty'));
  // Training uses the legacy Main building, and the existing account discovery.
  await db.exec('begin');
  await db.exec(`select public.peris_write_roster(${army},'{}');update public.buildings set level=1 where settlement_id=${home} and building_type='market';update public.settlements set wood=5000,stone=5000,food=5000,gold=5000 where id=${home}`);
  await db.exec('savepoint training');
  await assert.rejects(db.query(`select public.peris_queue_recruit('diplomat',1)`),/level 2/);
  await db.exec('rollback to training');
  await db.exec(`update public.buildings set level=2 where settlement_id=${home} and building_type='market'`);
  await db.exec('savepoint discovery');
  await assert.rejects(db.query(`select public.peris_queue_recruit('diplomat',1)`),/Diplomacy/);
  await db.exec('rollback to discovery');
  await db.exec(`insert into public.peris_research_progress(owner_id,technology_id,seconds,completed_at)select '${ids[0]}',id,seconds,public.peris_game_now()from public.peris_technology_catalog where id='diplomacy';select public.peris_queue_recruit('diplomat',1)`);
  assert.equal(await scalar(`select quantity from public.peris_orders where item='diplomat'`),1);
  assert.equal(Number(await scalar(`select wood from public.settlements where id=${home}`)),4600);
  await db.exec(`update public.peris_orders set finish_at=public.peris_game_now();select public.peris_settle('${ids[0]}')`);
  assert.equal(Number(await scalar(`select unit_roster->>'diplomat'from public.armies where id=${army}`)),1);
  await db.exec('savepoint capability;alter table public.peris_conquest_version rename to capture_not_installed');
  await assert.rejects(db.query(`select public.peris_queue_recruit('diplomat',1)`),/unavailable/);
  await db.exec('rollback to capability');
  await db.exec('rollback');
  await db.exec(`update public.settlements set loyalty=10,loyalty_updated_at='2030-01-01'where id=${city};select public.peris_loyalty_accrue(${city},'2030-01-01 02:00Z')`);
  assert.equal(Number(await scalar(`select loyalty from public.settlements where id=${city}`)),60);
  await db.exec(`select public.peris_loyalty_accrue(${city},'2030-01-01 01:00Z')`);
  assert.equal(Number(await scalar(`select loyalty from public.settlements where id=${city}`)),60);
  await db.exec(`select public.peris_loyalty_accrue(${city},'2030-01-02')`);
  assert.equal(Number(await scalar(`select loyalty from public.settlements where id=${city}`)),100);
  const battle=async(diplomats=40,alive=30,winner='attacker',beforeFinish='')=>{
   await db.exec(`update public.players set culture_points=100000,culture_updated_at=public.peris_game_now()where id='${ids[0]}';select public.peris_write_roster(${army},'{"infantry":100,"diplomat":${diplomats}}');update public.armies a set status='idle',raid_city_id=${city},raid_target_id=null,march_returning=false,start_x=s.x,start_y=s.y,target_x=s.x,target_y=s.y from public.settlements s where a.id=${army} and s.id=${city};update public.settlements set resources_updated_at=public.peris_game_now(),loyalty_updated_at=public.peris_game_now()where id=${city}`);
   const bid=await scalar(`select public.peris_start_city_raid('${ids[0]}',${army})`);assert.ok(bid);
   await db.exec(`update public.battle_formations set soldiers=0 where battle_id=${bid} and side='defender';update public.battle_formations set soldiers=${alive},status='routed'where battle_id=${bid} and side='attacker'and recruit_unit='diplomat'`);
   if(beforeFinish)await db.exec(beforeFinish);
   await db.exec(`select public.peris_finish(${bid},'${winner}','Capture fixture')`);
   return {bid,result:await scalar(`select result from public.battles where id=${bid}`)};
  };
  await db.exec(`update public.settlements set loyalty=100 where id=${city}`);
  const first=await battle();assert.equal(first.result.conquest.reduction,25);assert.equal(first.result.conquest.diplomats,30);assert.equal(first.result.conquest.captured,false);
  assert.equal(Number(await scalar(`select loyalty from public.settlements where id=${city}`)),75);
  const none=await battle(40,0);assert.equal(none.result.conquest.reduction,0);assert.equal(none.result.conquest.reason,'no_surviving_diplomats');
  const lost=await battle(40,30,'defender');assert.equal(lost.result.conquest.reason,'attacker_did_not_win');assert.equal(lost.result.conquest.reduction,0);assert.ok(Math.abs(Number(await scalar(`select loyalty from public.settlements where id=${city}`))-75)<.1);
  await db.exec('begin');
  const stale=await battle(40,30,'attacker',`update public.settlements set owner_id='${ids[0]}'where id=${city}`);
  assert.equal(stale.result.conquest.reason,'ownership_changed');assert.equal(stale.result.conquest.reduction,0);
  assert.equal(Object.values(stale.result.loot).reduce((sum:any,n:any)=>sum+Number(n),0),0);
  await db.exec('rollback');
  await db.exec(`update public.settlements set loyalty=3 where id=${city}`);
  // Eligibility is rechecked at settlement, including pending reservations.
  await db.exec('begin');
  await db.exec(`update public.players set culture_points=0 where id='${ids[0]}'`);
  const denied=await scalar(`select public.peris_apply_city_conquest(${city},'${ids[0]}',5,public.peris_game_now())`);assert.equal(denied.reason,'insufficient_culture');assert.equal(denied.reduction,0);
  await db.exec('rollback');
  await db.exec('begin');
  await db.exec(`insert into public.peris_settler_expeditions(owner_id,origin_settlement_id,col,row,name,departure_at,arrival_at,culture_cost,march_path)select '${ids[0]}',${home},n,99,'Reserved',public.peris_game_now(),public.peris_game_now()+interval '1 day',300,'[]'from generate_series(1,9)n`);
  const limited=await scalar(`select public.peris_apply_city_conquest(${city},'${ids[0]}',5,public.peris_game_now())`);assert.equal(limited.reason,'city_limit');assert.equal(limited.reduction,0);
  await db.exec(`delete from public.peris_settler_expeditions where col<>1;update public.players set culture_points=1000 where id='${ids[0]}'`);
  assert.equal((await scalar(`select public.peris_apply_city_conquest(${city},'${ids[0]}',5,public.peris_game_now())`)).reason,'insufficient_culture');
  await db.exec('rollback');
  // A surviving former owner keeps its commanders and troops through timed evacuation.
  await db.exec('begin');
  const backup=await scalar(`insert into public.settlements(owner_id,name,x,y,resources_updated_at)select '${ids[1]}','Backup',x,y,public.peris_game_now()from public.peris_camps c where not exists(select 1 from public.settlements s where s.x=c.x and s.y=c.y)limit 1 returning id`);
  await db.exec(`update public.settlements set faction=case id when ${home} then 'persian'when ${city} then 'orc'else 'elf'end where id in(${home},${city},${backup})`);
  assert.equal(await scalar(`select public.peris_account_faction('${ids[0]}')`),'persian');assert.equal(await scalar(`select public.peris_account_faction('${ids[1]}')`),'orc');
  await db.exec(`select public.peris_write_roster(${defender},'{"infantry":15,"diplomat":2}');insert into public.peris_city_garrisons values(${city},'${ids[1]}','{"diplomat":3}');insert into public.peris_orders(owner_id,settlement_id,kind,item,quantity,started_at,finish_at)values('${ids[1]}',${city},'upgrade','market',1,public.peris_game_now(),public.peris_game_now()+interval '1 day');insert into public.peris_unit_research values(${city},'spearmen',public.peris_game_now());insert into public.peris_map_plots(owner_id,settlement_id,col,row,building_type,level)select '${ids[1]}',${city},floor(x/128.0)::int,floor(y/128.0)::int+1,'farm',3 from public.settlements where id=${city}`);
  const receipt=await scalar(`select public.peris_apply_city_conquest(${city},'${ids[0]}',5,public.peris_game_now())`);assert.equal(receipt.captured,true);
  assert.equal(await scalar(`select public.peris_account_faction('${ids[0]}')`),'persian');assert.equal(await scalar(`select public.peris_account_faction('${ids[1]}')`),'orc');
  assert.equal(await scalar(`select home_settlement_id from public.armies where id=${defender}`),backup);
  assert.equal(await scalar(`select status from public.armies where id=${defender}`),'moving');
  assert.equal(await scalar(`select owner_id from public.peris_map_plots where settlement_id=${city}`),ids[0]);
  assert.equal(await scalar(`select count(*)::int from public.peris_orders where settlement_id=${city}`),0);
  assert.equal(await scalar(`select count(*)::int from public.peris_unit_research where settlement_id=${city}`),0);
  assert.equal(await scalar(`select troops->>'diplomat'from public.peris_ruin_evacuations where owner_id='${ids[1]}'`),'3');
  assert.equal(await scalar(`select defeated_at is null from public.players where id='${ids[1]}'`),true);
  await db.exec(`insert into public.peris_city_reinforcements(owner_id,source_settlement_id,target_settlement_id,troops,march_path,target_x,target_y,departure_at,arrival_at)select '${ids[1]}',${backup},${city},'{"diplomat":2}','[]',x,y,public.peris_game_now()-interval '2 seconds',public.peris_game_now()-interval '1 second'from public.settlements where id=${city};select public.peris_city_reinforcements_advance('${ids[1]}',public.peris_game_now())`);
  assert.equal(await scalar(`select target_settlement_id from public.peris_city_reinforcements where owner_id='${ids[1]}'`),backup);
  assert.equal(await scalar(`select count(*)::int from public.peris_city_garrisons where settlement_id=${city}`),0);
  const caravan=await scalar(`insert into public.peris_trade_caravans(owner_id,recipient_id,source_settlement_id,target_settlement_id,source_city,target_city,resources,returning_resources,volume,march_path,departure_at,arrival_at,return_at)values('${ids[1]}','${ids[1]}',${backup},${city},'Backup','Captured','{"wood":77,"stone":0,"food":0,"gold":0}','{"wood":77,"stone":0,"food":0,"gold":0}',77,'[[0,0],[1,1]]',public.peris_game_now()-interval '2 seconds',public.peris_game_now()-interval '1 second',public.peris_game_now()+interval '1 second')returning id`);
  const stock=await scalar(`select wood from public.settlements where id=${city}`);
  await db.exec(`select public.peris_trade_event(${caravan},public.peris_game_now())`);
  assert.equal(await scalar(`select wood from public.settlements where id=${city}`),stock);
  assert.equal(await scalar(`select delivered_resources->>'wood'from public.peris_trade_caravans where id=${caravan}`),'0');
  assert.equal(await scalar(`select returning_resources->>'wood'from public.peris_trade_caravans where id=${caravan}`),'77');
  // A settler launched by the old owner safely refunds into its living city.
  await db.exec(`insert into public.peris_settler_expeditions(owner_id,origin_settlement_id,col,row,name,departure_at,arrival_at,culture_cost,march_path)values('${ids[1]}',${city},99,99,'In flight',public.peris_game_now(),public.peris_game_now(),300,'[]');select public.peris_found_complete(currval(pg_get_serial_sequence('public.peris_settler_expeditions','id')))`);
  assert.equal(await scalar(`select settlers from public.settlements where id=${city}`),0);assert.equal(await scalar(`select settlers from public.settlements where id=${backup}`),3);
  await db.exec('rollback');
  const snapshot=await rows(`select wood,stone,food,gold,population,faction from public.settlements where id=${city}`);
  await db.exec(`update public.players set culture_points=1234,culture_updated_at=public.peris_game_now()where id='${ids[1]}'`);
  const captured=await battle(8,5,'attacker',`update public.armies set raid_reserve='{"diplomat":50}'where id=${army}`);assert.equal(captured.result.conquest.captured,true);assert.equal(captured.result.conquest.diplomats,5);assert.equal(captured.result.conquest.culture_cost,300);assert.equal(captured.result.conquest.new_owner_id,ids[0]);
  assert.equal(await scalar(`select owner_id from public.settlements where id=${city}`),ids[0]);
  assert.equal(Number(await scalar(`select loyalty from public.settlements where id=${city}`)),0);
  const after=await rows(`select wood,stone,food,gold,population,faction from public.settlements where id=${city}`);assert.equal(after[0].faction,snapshot[0].faction);assert.ok(Number(after[0].wood)>=Number(snapshot[0].wood));
  assert.equal((await rows(`select home_settlement_id,march_returning,status,unit_roster from public.armies where id=${army}`))[0].home_settlement_id,home);
  assert.equal(await scalar(`select march_returning from public.armies where id=${army}`),false);
  assert.equal(await scalar(`select status from public.armies where id=${army}`),'idle');
  assert.equal(Number(await scalar(`select unit_roster->>'diplomat'from public.armies where id=${army}`)),4);
  assert.equal(await scalar(`select unit_roster->>'diplomat'from public.peris_garrisons where owner_id='${ids[0]}'`),'50');
  assert.ok(await scalar(`select defeated_at is not null from public.players where id='${ids[1]}'`));
  assert.ok(Number(await scalar(`select culture_points from public.players where id='${ids[1]}'`))>=1234);
  assert.equal(await scalar(`select public.peris_roster_total(public.peris_roster(to_jsonb(a)))from public.armies a where id=${defender}`),0);
  const culture=await scalar(`select culture_points from public.players where id='${ids[0]}'`);
  await db.exec(`select public.peris_finish(${captured.bid},'attacker','replay')`);assert.equal(await scalar(`select culture_points from public.players where id='${ids[0]}'`),culture);
  await db.exec(await readFile('supabase/UPGRADE_CITY_CAPTURE.sql','utf8'));await db.exec(await readFile('supabase/UPGRADE_CITY_CAPTURE.sql','utf8'));
  assert.equal(Number(await scalar(`select loyalty from public.settlements where id=${city}`)),0);
  await db.exec(await readFile('supabase/UPGRADE_CROP_UPKEEP.sql','utf8'));await db.exec(await readFile('supabase/UPGRADE_CITY_LOGISTICS.sql','utf8'));
  assert.equal(Number(await scalar(`select loyalty from public.settlements where id=${city}`)),0);
  assert.equal(await scalar(`select public.peris_roster('{"diplomat":7}')->>'diplomat'`),'7');
  await db.exec(`set role authenticated`);await assert.rejects(db.query(`select public.peris_apply_city_conquest(${city},'${ids[0]}',50,public.peris_game_now())`),/permission denied/);await db.exec('reset role');
  console.log(`PASS city capture ${rate}x: live defended victory, routed and dead diplomats, cap, clocks, culture, occupation, last-city defeat, replay, privacy and migration rerun`);
 }catch(error:any){console.error(error.message,error.where??'',error.stack?.split('\n').slice(0,4).join('\n'));process.exitCode=1;break;}finally{await db.close();}
}
