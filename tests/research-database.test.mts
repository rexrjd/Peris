import {PGlite} from '@electric-sql/pglite';
import {readFile} from 'node:fs/promises';
import assert from 'node:assert/strict';
import {TECHNOLOGIES} from '../src/features/research/domain/catalog';
import {scienceRate,advanceResearch,ensureScience} from '../src/features/research/domain/science';
import {refreshCityEconomy} from '../src/features/city/domain/slots';
import type {World} from '../src/shared/model/world';
const db=new PGlite(),auth='11111111-1111-4111-8111-111111111111',otherAuth='22222222-2222-4222-8222-222222222222';
const admin=async(sql:string)=>{await db.exec('reset role');return db.exec(sql);};
const login=async(id:string)=>db.exec(`reset role;set role authenticated;select set_config('request.jwt.claim.sub','${id}',false)`);
const rpc=async(name:string,args:unknown[]=[])=> (await db.query<any>(`select public.${name}(${args.map((_,i)=>'$'+(i+1)).join(',')})as result`,args)).rows[0].result;
const snap=async()=>await rpc('peris_snapshot') as World;
const command=async(c:unknown)=>rpc('peris_empire_command',[JSON.stringify(c)]);
const approx=(a:number,b:number)=>assert.ok(Math.abs(a-b)<1e-6,`${a} != ${b}`);
try{
 await db.exec(`create schema auth;create table auth.users(id uuid primary key);create role anon;create role authenticated;create role service_role;create function auth.uid()returns uuid language sql as $$select nullif(current_setting('request.jwt.claim.sub',true),'')::uuid$$;grant usage on schema public,auth to authenticated,anon;grant execute on function auth.uid()to authenticated,anon;create publication supabase_realtime;`);
 await db.exec(await readFile('tests/fixtures/v5.sql','utf8'));await admin(await readFile('supabase/UPGRADE_TO_V18.sql','utf8'));
 await admin(`insert into auth.users values('${auth}'),('${otherAuth}')`);await login(auth);await rpc('create_player',['Science Tester']);let w=await snap();const owner=w.players[0].id,sid=w.settlements[0].id;
 await admin(`select public.peris_science_ensure('${owner}')`);const catalog=await db.query<any>('select metadata from public.peris_technology_catalog');assert.equal(catalog.rows.length,210);for(const row of catalog.rows)assert.deepEqual(row.metadata,TECHNOLOGIES.find(t=>t.id===row.metadata.id));console.log('PASS · 210 shared catalog technologies agree with authoritative SQL');
 await login(auth);await assert.rejects(()=>command({type:'startResearch',technologyId:'spear-formations'}),/prerequisites/i);await assert.rejects(()=>command({type:'startResearch',technologyId:'elf-living-groves'}),/another faction/i);
 const receipt='99999999-9999-4999-8999-999999999999',args=JSON.stringify({p_command:{type:'startResearch',technologyId:'writing'}});
 await rpc('peris_submit_command',[receipt,'peris_empire_command',args]);w=await snap();assert.ok(Number(w.account_science![0].points)>=40&&Number(w.account_science![0].points)<41);await rpc('peris_submit_command',[receipt,'peris_empire_command',args]);assert.equal((await snap()).research_progress!.length,1);console.log('PASS · ownership, prerequisites and exactly-once research cost');
 await admin(`update public.peris_account_science set active_since=now()-interval '10 seconds'where owner_id='${owner}'`);await login(auth);await command({type:'pauseResearch'});w=await snap();assert.ok(Number(w.research_progress![0].seconds)>=10);assert.equal(w.account_science![0].active_id,null);const points=Number(w.account_science![0].points);await command({type:'startResearch',technologyId:'writing'});assert.ok(Number((await snap()).account_science![0].points)>=points);console.log('PASS · persistent pause/resume retains work and paid points');
 await admin(`update public.peris_account_science set active_since=now()-interval '40 seconds'where owner_id='${owner}';select public.peris_game_tick(40)`);await login(auth);w=await snap();assert.ok(w.research_progress![0].completed_at);assert.equal(w.account_science![0].active_id,null);approx(scienceRate(w,owner),6.3);console.log('PASS · worker completes research with no browser and applies science bonus');
 await admin(`update public.settlements set wood=5000,stone=5000,food=5000,gold=5000 where id=${sid}`);await login(auth);await command({type:'buildSlot',slot:4,item:'academy',settlementId:sid});w=await snap();assert.equal(w.city_slots!.find(s=>s.slot_index===4)!.level,0);approx(scienceRate(w,owner),6.3);await admin(`update public.peris_orders set finish_at=now()-interval '1 second'where owner_id='${owner}'and item='slot:4:academy';select public.peris_settle('${owner}')`);await login(auth);w=await snap();assert.equal(w.city_slots!.find(s=>s.slot_index===4)!.level,1);approx(scienceRate(w,owner),18.9);
 await command({type:'buildSlot',slot:5,item:'academy',settlementId:sid});await admin(`update public.peris_orders set finish_at=now()-interval '1 second'where owner_id='${owner}'and item='slot:5:academy';select public.peris_settle('${owner}')`);await login(auth);w=await snap();assert.equal(w.city_slots!.filter(s=>s.building_type==='academy'&&s.level===1).length,2);approx(scienceRate(w,owner),31.5);console.log('PASS · repeatable Academy construction produces science only after completion');
 // Fixed clock checks offline income/progress parity independently of real wall time.
 const at='2026-10-12T00:00:00.000Z';await admin(`update public.peris_account_science set points=100,updated_at='${at}',active_id=null,active_since=null where owner_id='${owner}'`);await login(auth);w=await snap();const local=structuredClone(w);ensureScience(local,owner,Date.parse(at));advanceResearch(local,owner,Date.parse(at)+60000);await admin(`select public.peris_science_advance('${owner}','2026-10-12T00:01:00Z')`);await login(auth);approx(Number((await snap()).account_science![0].points),local.account_science![0].points);console.log('PASS · local and SQL offline science arithmetic agree');
 // Every effect is reachable and the cached resource and storage equations agree.
 await admin(`insert into public.peris_research_progress(owner_id,technology_id,seconds,completed_at)select '${owner}',id,seconds,now()from public.peris_technology_catalog where faction is null on conflict(owner_id,technology_id)do update set seconds=excluded.seconds,completed_at=excluded.completed_at;select public.peris_city_economy(${sid})`);await login(auth);w=await snap();const projected=structuredClone(w);refreshCityEconomy(projected,sid);for(const key of ['wood_rate','stone_rate','food_rate','gold_rate','capacity','food_capacity']as const)approx(Number(w.settlements[0][key]),Number(projected.settlements[0][key]));await admin(`insert into public.peris_city_slots(settlement_id,slot_index,building_type,level)values(${sid},0,'barracks',1)on conflict(settlement_id,slot_index)do update set level=1;select public.peris_city_economy(${sid})`);await login(auth);await command({type:'recruit',item:'spearmen',quantity:1,settlementId:sid,armyId:w.armies[0].id});console.log('PASS · all passive effects pool account discoveries; global advanced troop unlocks work');
 await login(otherAuth);await rpc('create_player',['Other Scholar']);const rival=await snap();assert.ok(rival.account_science!.every(s=>s.owner_id!==owner));assert.equal((await db.query(`select count(*)as n from public.peris_research_progress where owner_id='${owner}'`)).rows[0].n,0);await assert.rejects(()=>rpc('peris_science_advance',[owner,at]));await assert.rejects(()=>db.exec(`update public.peris_account_science set points=99999`));console.log('PASS · rival science and research are private; clients cannot mutate tables or helpers');
 await admin(await readFile('supabase/UPGRADE_TO_V18.sql','utf8'));await login(auth);w=await snap();assert.equal(w.city_slots!.filter(s=>s.building_type==='academy').length,2);assert.equal(w.research_progress!.filter(p=>p.completed_at).length,100);console.log('PASS · rerunning V18 retains Academy rows, completed research and accounts');
 console.log('ALL RESEARCH DATABASE CHECKS PASSED');
}finally{await db.close();}
