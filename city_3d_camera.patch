+    smoke.frustumCulled = motes.frustumCulled = false; smoke.count = motes.count = 0;
+    group.add(smoke, motes); group.name = 'City work and ambient effects';
+    const chimneys: THREE.Vector3[] = [], magic: THREE.Vector3[] = [], transform = new THREE.Object3D();
+    function setModels(models: ReadonlyMap<string, Model>, plots: CityPlot[], faction: Faction) {
+        parts.length = chimneys.length = magic.length = 0;
+        motes.material.color.set(FACTIONS[faction].water);
+        for (const plot of plots) {
+            const model = models.get(plot.key)?.model;
+            if (!model || !plot.level) continue;
+            model.updateMatrixWorld(true);
+            model.traverse(object => {
+                if (object.userData.cityMotion) {
+                    let base = originals.get(object);
+                    if (!base) { base = { position: object.position.clone(), rotation: object.rotation.clone() }; originals.set(object, base); }
+                    parts.push({ object, kind: object.userData.cityMotion, ...base, phase: plot.x * .17 + plot.z * .29 });
+                }
+            });
+            if (plot.type === 'smithy') chimneys.push(model.localToWorld(new THREE.Vector3(.4, 1.35 + plot.level * .12, -.25)));
+            if (plot.type === 'housing') chimneys.push(model.localToWorld(new THREE.Vector3(0, 1 + plot.level * .13, -.1)));
+            if (plot.type === 'lumber') chimneys.push(model.localToWorld(new THREE.Vector3(-.25, 1.15 + plot.level * .06, -.15)));
+            if (plot.type === 'mage_tower') magic.push(model.localToWorld(new THREE.Vector3(0, 1.4 + plot.level * .2, 0)));
+        }
+        smoke.count = Math.min(smoke.instanceMatrix.count, chimneys.length * 6);
+        motes.count = Math.min(motes.instanceMatrix.count, magic.length * 12);
+    }
+    function animate(seconds: number, reduced = false) {
+        for (const part of parts) {
+            const { object, kind, position, rotation, phase } = part, t = seconds + phase;
+            object.position.copy(position); object.rotation.copy(rotation);
+            if (reduced) continue;
+            if (kind === 'spin') object.rotation.y += seconds * 1.5;
+            if (kind === 'spinSlow') object.rotation.z += seconds * .65;
+            if (kind === 'flag') { object.rotation.y += Math.sin(t * 2.3) * .16; object.rotation.z += Math.sin(t * 2.3 + 1) * .035; }
+            if (kind === 'lift') object.position.y += (1 + Math.sin(t * .8)) * .12;
+            if (kind === 'hammer') object.rotation.x -= Math.max(0, Math.sin(t * 3)) * .7;
+            if (kind === 'fishing') object.rotation.z += Math.sin(t * .8) * .07;
+            if (kind === 'crystal') { object.position.y += Math.sin(t * 1.6) * .1; object.rotation.y += seconds * .4; }
+        }
+        smoke.visible = motes.visible = !reduced;
+        if (reduced) return;
+        for (let i = 0; i < smoke.count; i++) {
+            const source = chimneys[Math.floor(i / 6)], rise = (seconds * .22 + (i % 6) / 6 + i * .017) % 1;
+            transform.position.set(source.x + rise * .35 + Math.sin(seconds + i) * .035, source.y + rise * 1.25, source.z + rise * .13);
+            transform.rotation.set(0, seconds * .1 + i, 0); transform.scale.setScalar(Math.sin(rise * Math.PI) * (1 + rise * 1.5));
+            transform.updateMatrix(); smoke.setMatrixAt(i, transform.matrix);
+        }
+        for (let i = 0; i < motes.count; i++) {
+            const source = magic[Math.floor(i / 12)], angle = seconds * .45 + i * Math.PI / 6;
+            transform.position.set(source.x + Math.cos(angle) * .6, source.y + Math.sin(seconds * .8 + i) * .35, source.z + Math.sin(angle) * .6);
+            transform.rotation.set(seconds, angle, 0); transform.scale.setScalar(.6 + Math.sin(seconds + i) * .25);
+            transform.updateMatrix(); motes.setMatrixAt(i, transform.matrix);
+        }
+        smoke.instanceMatrix.needsUpdate = motes.instanceMatrix.needsUpdate = true;
+    }
+    return { group, setModels, animate };
+}
diff --git a/tests/city-camera.test.ts b/tests/city-camera.test.ts
new file mode 100644
index 0000000..17e6350
--- /dev/null
+++ b/tests/city-camera.test.ts
@@ -0,0 +1,67 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import * as THREE from 'three';
+import { CityCamera } from '../src/features/city/rendering/three/CityCamera';
+import { createBuildingModel } from '../src/features/city/rendering/three/buildingModels';
+import { createSlotModel } from '../src/features/city/rendering/three/slotModels';
+import { createCityActivities } from '../src/features/city/rendering/three/cityActivities';
+import { cityLayout } from '../src/features/city/rendering/three/layout';
+import { disposeCityObject } from '../src/features/city/rendering/three/modelKit';
+import { FACTIONS, type Faction } from '../src/features/factions/domain/factions';
+
+test('city camera preserves the cursor ground point and zoom/rotation through resize and expansion', () => {
+    const view = new CityCamera(); view.resize(1440, 700, 2);
+    const anchor = new THREE.Vector2(.15, -.1), before = view.ground(anchor)!;
+    view.zoom(1.5, anchor);
+    assert.ok(before.distanceTo(view.ground(anchor)!) < 1e-8);
+    view.rotate(Math.PI / 2, true); view.resize(500, 700, 5);
+    assert.equal(view.rotation, Math.PI / 2); assert.equal(view.camera.zoom, 1.5);
+    view.zoom(100); assert.equal(view.camera.zoom, 3);
+    view.zoom(.0001); assert.equal(view.camera.zoom, .7);
+    view.reset(); assert.equal(view.rotation, 0); assert.equal(view.camera.zoom, 1);
+    assert.equal(view.target.x, 0);
+});
+
+test('camera remains finite after invalid inputs and smooth rotation finishes at its requested angle', () => {
+    const view = new CityCamera(); view.resize(0, 0, 0);
+    view.zoom(NaN); view.zoom(-1); view.rotate(Infinity);
+    assert.equal(view.camera.zoom, 1); assert.equal(view.rotation, 0);
+    view.rotate(Math.PI / 8); assert.ok(view.moving);
+    for (let i = 0; i < 100; i++) view.step(1 / 30, false);
+    assert.equal(view.rotation, Math.PI / 8); assert.equal(view.moving, false);
+    view.rotate(-Math.PI / 4); view.step(0, true);
+    assert.equal(view.rotation, -Math.PI / 8);
+});
+
+test('all factions keep static map models and opt into separate working city parts', () => {
+    for (const faction of Object.keys(FACTIONS) as Faction[]) {
+        const staticModel = createBuildingModel('farm', 5, faction);
+        let staticMotion = 0; staticModel.traverse(object => { if (object.userData.cityMotion) staticMotion++; });
+        assert.equal(staticMotion, 0);
+        const working = createBuildingModel('farm', 5, faction, true);
+        let blades = 0; working.traverse(object => { if (object.userData.cityMotion === 'spinSlow') blades++; });
+        assert.equal(blades, 2);
+        const activities = createCityActivities(), plots = cityLayout({ farm: 5 }, []);
+        activities.setModels(new Map([['farm', { model: working }]]), plots, faction);
+        const blade = working.children.find(object => object.userData.cityMotion === 'spinSlow')!;
+        const original = blade.rotation.z;
+        activities.animate(4); assert.notEqual(blade.rotation.z, original);
+        // Economy updates reuse existing models; their rest transforms must not drift.
+        activities.setModels(new Map([['farm', { model: working }]]), plots, faction);
+        activities.animate(0, true); assert.equal(blade.rotation.z, original);
+        disposeCityObject(staticModel); disposeCityObject(working); disposeCityObject(activities.group);
+    }
+});
+
+test('smoke and mage effects are batched, disappear for reduced motion, and clear after demolition', () => {
+    const smithy = createSlotModel('smithy', 5, 'roman', true), mage = createSlotModel('mage_tower', 10, 'roman', true);
+    const plots = cityLayout({}, [{ settlement_id: 1, slot_index: 0, building_type: 'smithy', level: 5 }, { settlement_id: 1, slot_index: 1, building_type: 'mage_tower', level: 10 }]);
+    smithy.position.set(plots[6].x, 0, plots[6].z); mage.position.set(plots[7].x, 0, plots[7].z);
+    const activities = createCityActivities(); activities.setModels(new Map([['slot:0', { model: smithy }], ['slot:1', { model: mage }]]), plots, 'roman');
+    const [smoke, motes] = activities.group.children as THREE.InstancedMesh[];
+    assert.equal(smoke.count, 6); assert.equal(motes.count, 12);
+    activities.animate(2); assert.ok(smoke.visible && motes.visible);
+    activities.animate(2, true); assert.ok(!smoke.visible && !motes.visible);
+    activities.setModels(new Map(), [], 'roman'); assert.equal(smoke.count + motes.count, 0);
+    disposeCityObject(smithy); disposeCityObject(mage); disposeCityObject(activities.group);
+});
diff --git a/tests/e2e/city-camera.spec.ts b/tests/e2e/city-camera.spec.ts
new file mode 100644
index 0000000..9faeafa
--- /dev/null
+++ b/tests/e2e/city-camera.spec.ts
@@ -0,0 +1,78 @@
+import { test, expect, type Page } from '@playwright/test';
+import { createSolo } from '../../src/features/campaign/domain/newRealm';
+import { refreshCityEconomy, type SlotType } from '../../src/features/city/domain/slots';
+
+async function city(page: Page) {
+    const world = createSolo('Camera test');
+    world.buildings.forEach(building => { building.level = 5; });
+    world.city_slots = ['smithy', 'academy', 'housing', 'mage_tower', 'granary', 'stables'].map((type, i) => ({ settlement_id: 1, slot_index: i, building_type: type as SlotType, level: type === 'mage_tower' ? 10 : 5 }));
+    world.city_slots.push({ settlement_id: 1, slot_index: 16, building_type: 'fishery', level: 5 });
+    refreshCityEconomy(world, 1);
+    await page.addInitScript(w => {
+        localStorage.setItem('peris-campaign-v6', JSON.stringify(w));
+        localStorage.setItem('peris-settings', JSON.stringify({ sound: false, music: false, reducedMotion: true }));
+        localStorage.setItem(`peris-welcome:${w.players[0].id}:${w.players[0].created_at}`, 'yes');
+    }, world);
+    await page.goto('/');
+    await page.getByRole('button', { name: 'Continue campaign', exact: true }).click();
+    await page.getByRole('button', { name: 'City', exact: true }).click();
+    await page.getByRole('button', { name: '3D', exact: true }).click();
+    await expect(page.locator('.city-3d-scene.ready canvas')).toBeVisible();
+    return page.locator('.city-3d-scene canvas');
+}
+
+test('wheel and bottom controls rotate and zoom the real 3D city; reset restores framing', async ({ page, isMobile }, info) => {
+    const errors: string[] = []; page.on('pageerror', error => errors.push(error.message));
+    const canvas = await city(page);
+    await expect(canvas).toHaveAttribute('data-city-zoom', '1.000');
+    if (!isMobile) {
+        const bounds = (await canvas.boundingBox())!;
+        await page.mouse.move(bounds.x + bounds.width * .52, bounds.y + bounds.height * .5);
+        await page.mouse.wheel(0, -200);
+        await expect.poll(async () => Number(await canvas.getAttribute('data-city-zoom'))).toBeGreaterThan(1.3);
+        await page.mouse.wheel(0, 400);
+        await expect.poll(async () => Number(await canvas.getAttribute('data-city-zoom'))).toBeLessThan(1);
+        await page.keyboard.press('q'); await expect(canvas).toHaveAttribute('data-city-rotation', '-0.393');
+        await page.keyboard.press('e'); await expect(canvas).toHaveAttribute('data-city-rotation', '0.000');
+    }
+    await page.getByRole('button', { name: 'Reset city camera', exact: true }).click();
+    await expect(canvas).toHaveAttribute('data-city-zoom', '1.000');
+    await page.getByRole('button', { name: 'Rotate city right', exact: true }).click();
+    await expect(canvas).toHaveAttribute('data-city-rotation', '0.393');
+    await page.getByRole('button', { name: 'Zoom city in', exact: true }).click();
+    await expect(canvas).toHaveAttribute('data-city-zoom', '1.200');
+    await page.getByRole('button', { name: 'Zoom city out', exact: true }).click();
+    await expect(canvas).toHaveAttribute('data-city-zoom', '1.000');
+    await page.screenshot({ path: info.outputPath('city-rotated.png') });
+    await page.locator('[data-building="market"]').click();
+    await expect(page.getByRole('dialog')).toBeVisible();
+    const rotation = await canvas.getAttribute('data-city-rotation');
+    await page.keyboard.press('q'); await expect(canvas).toHaveAttribute('data-city-rotation', rotation!);
+    await page.keyboard.press('Escape');
+    await page.getByRole('button', { name: 'Open city building list', exact: true }).click();
+    await page.getByRole('searchbox', { name: 'Find a city building' }).fill('qe');
+    await page.keyboard.press('q'); await expect(canvas).toHaveAttribute('data-city-rotation', rotation!);
+    await page.getByRole('button', { name: 'Close city panel', exact: true }).click();
+    await page.getByRole('button', { name: 'Reset city camera', exact: true }).click();
+    await expect(canvas).toHaveAttribute('data-city-rotation', '0.000');
+    expect(await page.evaluate(() => document.documentElement.scrollWidth <= innerWidth)).toBe(true);
+    await page.screenshot({ path: info.outputPath('city-default.png') });
+    expect(errors).toEqual([]);
+});
+
+test('building effects render and city controls resume when reduced motion is toggled', async ({ page, isMobile }, info) => {
+    test.skip(isMobile, 'Shared renderer motion is exercised once on desktop; touch camera controls have their own coverage.');
+    const canvas = await city(page);
+    await page.evaluate(() => document.documentElement.classList.remove('reduced-motion'));
+    await page.getByRole('button', { name: 'Zoom city in', exact: true }).click();
+    await page.screenshot({ path: info.outputPath('city-working.png') });
+    await page.getByRole('button', { name: 'Rotate city right', exact: true }).click();
+    await expect(canvas).toHaveAttribute('data-city-rotation', '0.393');
+    await page.evaluate(() => document.documentElement.classList.add('reduced-motion'));
+    await page.getByRole('button', { name: 'Reset city camera', exact: true }).click();
+    await expect(canvas).toHaveAttribute('data-city-rotation', '0.000');
+    await page.evaluate(() => document.documentElement.classList.remove('reduced-motion'));
+    await page.getByRole('button', { name: 'Rotate city left', exact: true }).click();
+    await expect(canvas).toHaveAttribute('data-city-rotation', '-0.393');
+    await page.screenshot({ path: info.outputPath('city-working-rotated.png') });
+});
