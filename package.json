{
  "name": "peris",
  "private": true,
  "version": "0.8.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "check:frontier": "tsc -p tsconfig.frontier.json",
    "test:frontier-server": "node --import tsx --test tests/frontier-server.test.mts tests/frontier-http.test.mts tests/frontier-vite.test.mts",
    "test:frontier-ui": "playwright test -c playwright.integration.config.ts tests/e2e/game-frontier-integration.spec.ts tests/e2e/command-retry.spec.ts",
    "build": "npm run check:artifact-art && npm run check:research-art && tsc -p tsconfig.app.json && vite build",
    "build:standalone": "npm run build && node scripts/standalone.mjs",
    "preview": "vite preview",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:db": "node tests/database.test.mjs",
    "test:unattended-db": "node --import tsx tests/unattended-battle-database.test.mts",
    "test:battle-atomicity-db": "node --import tsx tests/battle-worker-atomicity.test.mts",
    "test:clock-db": "node --import tsx tests/game-clock-database.test.mts",
    "test:clock-gameplay-db": "node --import tsx tests/game-clock-gameplay.test.mts",
    "test:clock-upgrade-db": "node --import tsx tests/game-clock-upgrade.test.mts",
    "test:clock-journeys-db": "node --import tsx tests/game-clock-journeys.test.mts",
    "test:server-concurrency": "node --import tsx tests/server-reliability-concurrency.test.mts",
    "check:server-reliability": "node --import tsx scripts/check-server-reliability.mts",
    "test:fresh": "node tests/fresh-database.test.mjs",
    "build:world": "node --import tsx scripts/build-world.mjs",
    "check:world": "node --import tsx scripts/build-world.mjs --check",
    "build:sql": "node scripts/build-unit-balance.mjs && node scripts/build-research-catalog.mjs && node scripts/build-sql.mjs",
    "check:sql": "node scripts/build-unit-balance.mjs --check && node scripts/build-research-catalog.mjs --check && node scripts/build-sql.mjs --check",
    "test:unit-balance-db": "node --import tsx tests/unit-balance-database.test.mts",
    "check:unit-balance": "node scripts/build-unit-balance.mjs --check && node --import tsx scripts/check-unit-balance.mts",
    "balance:units": "node --import tsx scripts/check-unit-balance.mts --full",
    "test:city-db": "node tests/city-slots-database.test.mjs",
    "test:city-environment-db": "node --import tsx tests/city-environment-database.test.mts",
    "test:magic-db": "node --import tsx tests/magic-database.test.mjs",
    "test:factions-db": "node tests/factions-database.test.mjs",
    "test:territory-db": "node tests/map-territory-database.test.mjs",
    "test:map-db": "node tests/map-snapshot-database.test.mjs",
    "test:empire-db": "node --import tsx tests/empire-heroes-database.test.mjs",
    "test:population-db": "node --import tsx tests/population-database.test.mjs",
    "setup:dev": "node scripts/setup-dev.mjs",
    "check:dev": "node scripts/setup-dev.mjs --check",
    "test:tooling": "node --test tests/tooling.test.mjs",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "assets:check": "node scripts/check-assets.mjs",
    "assets:inspect": "gltf-transform inspect",
    "assets:optimize": "gltf-transform optimize",
    "assets:validate": "gltf-transform validate",
    "test:automatic-db": "node tests/automatic-battle-database.test.mjs",
    "test:slot-upgrade-db": "node tests/city-slot-upgrade-database.test.mjs",
    "build:bandits": "node --import tsx scripts/build-bandits.mjs",
    "check:bandits": "node --import tsx scripts/build-bandits.mjs --check",
    "test:world-battles-db": "node --import tsx tests/world-battles-database.test.mjs",
    "test:world-battles-ui": "node tests/world-battles-ui-render.test.mjs",
    "build:hero-portraits": "node scripts/build-hero-portraits.mjs",
    "test:hero-loot-db": "node --import tsx tests/hero-loot-database.test.mjs",
    "test:hero-loot-ui": "node tests/hero-loot-ui-render.test.mjs",
    "test:signup-db": "node tests/signup-database.test.mjs",
    "test:accounts-db": "node tests/accounts-database.test.mjs",
    "test:integration-db": "node --import tsx tests/game-integration-database.test.mts",
    "test:account-directory-db": "node tests/account-directory-database.test.mjs",
    "test:account-compatibility-db": "node --import tsx tests/account-compatibility-database.test.mjs",
    "build:artifact-catalog": "node --import tsx scripts/build-artifact-catalog.mjs",
    "check:artifact-catalog": "node --import tsx scripts/build-artifact-catalog.mjs --check",
    "build:artifact-art": "node scripts/build-artifact-art.mjs",
    "build:camp-artifact-upgrade": "node --import tsx scripts/build-camp-artifact-upgrade.mjs",
    "check:camp-artifact-upgrade": "node --import tsx scripts/build-camp-artifact-upgrade.mjs --check",
    "test:artifact-camps-db": "node --import tsx tests/artifact-camp-upgrade.test.mjs",
    "test:command-receipts-db": "node --import tsx tests/command-receipts-database.test.mts",
    "test:farm-parity-db": "node tests/campaign-farm-parity-database.test.mjs",
    "test:army-parity-db": "node --import tsx tests/army-role-operations-database.test.mts",
    "check:artifact-art": "node --import tsx scripts/check-artifact-art.mjs",
    "build:report-reads": "node scripts/build-report-read-upgrade.mjs",
    "check:report-reads": "node scripts/build-report-read-upgrade.mjs --check",
    "test:report-reads-db": "node tests/report-reads-database.test.mjs",
    "test:player-raids-db": "node --import tsx tests/player-city-raids-database.test.mts",
    "test:city-garrisons-db": "node --import tsx tests/city-garrisons-database.test.mts",
    "test:city-logistics-db": "node --import tsx tests/city-garrison-logistics-database.test.mts",
    "build:ui-icons": "node scripts/build-ui-icons.mjs",
    "check:ui-icons": "node scripts/build-ui-icons.mjs --check",
    "build:research-art": "node scripts/build-research-art.mjs",
    "build:research-catalog": "node scripts/build-research-catalog.mjs",
    "check:research-catalog": "node scripts/build-research-catalog.mjs --check",
    "check:research-art": "node scripts/check-research-art.mjs",
    "test:research-db": "node --import tsx tests/research-database.test.mts",
    "test:social-db": "node --import tsx tests/social-database.test.mts",
    "test:guild-reinforcements-db": "node --import tsx tests/guild-reinforcements-database.test.mts",
    "test:market-db": "node --import tsx tests/market-database.test.mts"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.57.4",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "react-icons": "5.5.0",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.3.10",
    "@gltf-transform/cli": "4.5.1",
    "@playwright/test": "1.64.0",
    "@types/react": "19.1.13",
    "@types/react-dom": "19.1.9",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "4.7.0",
    "sharp": "0.35.5",
    "tsx": "4.20.5",
    "typescript": "5.9.2",
    "vite": "6.3.6"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
