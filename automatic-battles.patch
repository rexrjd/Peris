+ for f in select * from public.battle_formations where battle_id=b.id and soldiers>0 order by id loop
+ if f.status='routed'then f.x:=greatest(12,least(1188,f.x+case when f.side='attacker'then -1 else 1 end*64*dt));f.facing:=case when f.side='attacker'then 180 else 0 end;
