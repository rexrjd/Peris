+ best:=greatest(0,sqrt(power(t.x-f.x,2)+power(t.y-f.y,2))-public.peris_contact(f,t))+coalesce((loads->>t.id::text)::integer,0)*45-case when f.unit_type='cavalry'and t.unit_type='archers'then 110 else 0 end;
