+ spell_ready_defender=case when own_side='defender' then b.elapsed+8 else spell_ready_defender end,
+ last_spell=jsonb_build_object('id',sp.id,'name',sp.name,'owner_id',u,'at',b.elapsed,'target',t.id) where id=b.id;
